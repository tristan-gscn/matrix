from collections.abc import Iterator
from typing import Self, overload

class Vector:
    def __init__(self, data: list[float]) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> float: ...
    def __iter__(self) -> Iterator[float]: ...
    def __eq__(self, other: object) -> bool: ...
    def __repr__(self) -> str: ...
    def copy(self) -> Self: ...
    def __add__(self, other: "Vector") -> "Vector": ...
    def __sub__(self, other: "Vector") -> "Vector": ...
    def __mul__(self, a: float) -> "Vector": ...
    def dot(self, other: "Vector") -> float: ...
    def norm_1(self) -> float: ...
    def norm(self) -> float: ...
    def norm_inf(self) -> float: ...

class Matrix:
    def __init__(self, rows: list[list[float]]) -> None: ...
    def copy(self) -> Self: ...
    def shape(self) -> tuple[int, int]: ...
    def __eq__(self, other: object) -> bool: ...
    def __repr__(self) -> str: ...
    def __add__(self, other: "Matrix") -> "Matrix": ...
    def __sub__(self, other: "Matrix") -> "Matrix": ...
    @overload
    def __mul__(self, a: float) -> "Matrix": ...
    @overload
    def __mul__(self, a: "Vector") -> "Vector": ...
    @overload
    def __mul__(self, a: "Matrix") -> "Matrix": ...
    def mul_vec(self, vec: "Vector") -> "Vector": ...
    def mul_mat(self, mat: "Matrix") -> "Matrix": ...
    def trace(self) -> float: ...
    def transpose(self) -> "Matrix": ...
    def row_echelon(self, reduce: bool = True) -> "Matrix": ...
    def determinant(self) -> float: ...
